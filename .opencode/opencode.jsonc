{
  "$schema": "https://opencode.ai/config.json",

  "model": "openrouter/deepseek/deepseek-v4-pro-0813",

  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    }
  },

  "permission": {
    "*": "ask",

    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "list": "allow",

    "edit": "ask",

    "bash": {
      "*": "ask",
      "npm *": "allow",
      "yarn *": "allow",
      "npx *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "grep *": "allow",
      "mkdir *": "ask",
      "cp *": "ask",
      "rm *": "ask"
    },

    "webfetch": "allow",
    "websearch": "allow"
  },

  "agent": {
    "arquiteto-backend": {
      "mode": "subagent",
      "model": "openrouter/deepseek/deepseek-v4-flash-0731",
      "permission": { "task": { "*": "deny" } }
    },
    "cientista-de-dados": {
      "mode": "subagent",
      "model": "openrouter/deepseek/deepseek-v4-flash-0731",
      "permission": { "task": { "*": "deny" } }
    },
    "curador-historiador": {
      "mode": "subagent",
      "model": "openrouter/deepseek/deepseek-v4-flash-0731",
      "permission": { "task": { "*": "deny" } }
    },
    "designer-frontend": {
      "mode": "subagent",
      "model": "openrouter/deepseek/deepseek-v4-flash-0731",
      "permission": { "task": { "*": "deny" } }
    },
    "engenheiro-de-dados": {
      "mode": "subagent",
      "model": "openrouter/deepseek/deepseek-v4-flash-0731",
      "permission": { "task": { "*": "deny" } }
    }
  }
}
